#!/usr/bin/env python3
"""PreToolUse router for CPython/CinderX validation commands."""

from __future__ import annotations

import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


ACK_ENV = "CPYTHON_OPTIMIZE_HOOK_ACK"


def load_payload() -> dict:
    try:
        data = json.load(sys.stdin)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def tool_input(payload: dict) -> dict:
    value = payload.get("tool_input")
    return value if isinstance(value, dict) else {}


def extract_command(payload: dict) -> str:
    input_data = tool_input(payload)
    command = input_data.get("command") or input_data.get("cmd")
    if not command:
        command = payload.get("command") or payload.get("cmd")
    return command if isinstance(command, str) else ""


def extract_cwd(payload: dict) -> Path:
    input_data = tool_input(payload)
    for key in ("cwd", "workdir", "working_dir"):
        value = input_data.get(key) or payload.get(key)
        if isinstance(value, str) and value:
            return Path(value).expanduser()
    return Path.cwd()


def emit_context(message: str) -> None:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "additionalContext": message,
                }
            },
            ensure_ascii=False,
            indent=2,
        )
    )


def emit_deny(reason: str) -> None:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            },
            ensure_ascii=False,
            indent=2,
        )
    )


def shell_tokens(command: str) -> list[str]:
    try:
        return shlex.split(command, posix=True)
    except ValueError:
        return []


def has_ack(tokens: list[str]) -> bool:
    if os.environ.get(ACK_ENV) == "1":
        return True
    return any(token == f"{ACK_ENV}=1" for token in tokens)


def trim_wrappers(tokens: list[str]) -> list[str]:
    tokens = list(tokens)
    while tokens and "=" in tokens[0] and not tokens[0].startswith("-"):
        tokens.pop(0)
    if tokens[:1] == ["env"]:
        tokens = tokens[1:]
        while tokens and "=" in tokens[0] and not tokens[0].startswith("-"):
            tokens.pop(0)
    if tokens[:1] == ["time"]:
        tokens = tokens[1:]
    if tokens[:1] == ["timeout"] and len(tokens) >= 3:
        tokens = tokens[2:]
    return tokens


def command_chunks(tokens: list[str]) -> list[list[str]]:
    chunks: list[list[str]] = []
    current: list[str] = []
    for token in tokens:
        if token in {";", "&&", "||", "|"}:
            if current:
                chunks.append(trim_wrappers(current))
                current = []
            continue
        current.append(token)
    if current:
        chunks.append(trim_wrappers(current))
    return [chunk for chunk in chunks if chunk]


def is_python_executable(token: str) -> bool:
    name = Path(token).name
    return name == "python" or name.startswith("python3") or name in {"python.exe", "python3.exe"}


def is_pip_executable(token: str) -> bool:
    name = Path(token).name
    return name == "pip" or name.startswith("pip3") or name in {"pip.exe", "pip3.exe"}


def starts_pip_install(tokens: list[str]) -> tuple[bool, int]:
    if len(tokens) >= 2 and is_pip_executable(tokens[0]) and tokens[1] == "install":
        return True, 2
    if len(tokens) >= 4 and is_python_executable(tokens[0]) and tokens[1:4] == ["-m", "pip", "install"]:
        return True, 4
    if len(tokens) >= 3 and Path(tokens[0]).name == "uv" and tokens[1:3] == ["pip", "install"]:
        return True, 3
    return False, 0


def has_local_project_install_arg(args: list[str]) -> bool:
    index = 0
    while index < len(args):
        token = args[index]
        next_token = args[index + 1] if index + 1 < len(args) else ""
        if token == ".":
            return True
        if token in {"-e", "--editable"} and next_token == ".":
            return True
        if token in {"--config-settings", "-C"}:
            index += 2
            continue
        if token.startswith("--editable=.") or token.startswith("-e."):
            return True
        index += 1
    return False


def is_pip_install_local_project(tokens: list[str]) -> bool:
    ok, arg_start = starts_pip_install(tokens)
    return ok and has_local_project_install_arg(tokens[arg_start:])


def starts_perf_cli(tokens: list[str]) -> tuple[bool, str, int]:
    if not tokens:
        return False, "", 0
    command = Path(tokens[0]).name
    if command in {"pyperf", "pyperformance"}:
        return True, command, 1
    if len(tokens) >= 3 and is_python_executable(tokens[0]) and tokens[1] == "-m" and tokens[2] in {"pyperf", "pyperformance"}:
        return True, tokens[2], 3
    return False, "", 0


def has_benchmark_subset(args: list[str]) -> bool:
    for index, token in enumerate(args):
        if token.startswith("--benchmarks=") or token.startswith("-b="):
            return True
        if token in {"--benchmarks", "-b"} and index + 1 < len(args):
            return True
    return False


def is_cinderx_run_gate(tokens: list[str]) -> tuple[bool, str, bool]:
    for index, token in enumerate(tokens):
        path = Path(token)
        is_gate = path.name == "run_gate.py" and ("ci_pipeline" in path.parts or str(path) == "ci_pipeline/run_gate.py")
        if not is_gate:
            continue
        args = tokens[index + 1 :]
        suite = ""
        for arg_index, arg in enumerate(args):
            if arg.startswith("--suite="):
                suite = arg.split("=", 1)[1]
                break
            if arg == "--suite" and arg_index + 1 < len(args):
                suite = args[arg_index + 1]
                break
        if suite == "runtime":
            return True, "RuntimeTests 功能测试; skills: cpython-runtime-test-run", True
        if suite == "cinderx_local":
            return True, "test_cinderx/lib test 集成测试; skills: cpython-runtime-test-run", False
        return True, "CinderX run_gate 测试; skills: cpython-runtime-test-run", False
    return False, "", False


def is_pyperformance_worker_command(tokens: list[str]) -> bool:
    return "--worker" in tokens and any(Path(token).name == "run_benchmark.py" for token in tokens)


def is_cinderx_benchmark_helper(tokens: list[str]) -> bool:
    return any(Path(token).name in {"test-benchmark.sh", "benchmark_harness.py"} for token in tokens)


def is_runtime_test(tokens: list[str]) -> tuple[bool, bool]:
    if len(tokens) >= 4 and is_python_executable(tokens[0]) and tokens[1:3] == ["-m", "test"]:
        args = tokens[3:]
    elif len(tokens) >= 3 and Path(tokens[0]).name == "python" and tokens[1:3] == ["-m", "test"]:
        args = tokens[3:]
    elif tokens[:2] == ["make", "test"] or tokens[:1] == ["pytest"]:
        return True, False
    else:
        return False, False

    positional = [arg for arg in args if not arg.startswith("-")]
    has_named_tests = any(arg.startswith(("test_", "Lib/test/", "cinderx")) for arg in positional)
    return True, not has_named_tests


def is_build_or_test(tokens: list[str]) -> bool:
    if not tokens:
        return False
    command = Path(tokens[0]).name
    if command in {"pytest", "ctest", "ninja"}:
        return True
    if command == "make":
        return True
    if command == "cmake" and "--build" in tokens:
        return True
    return False


def is_pyvenv_cfg_mutation(tokens: list[str], command: str) -> bool:
    raw = command.lower()
    if "pyvenv.cfg" not in raw:
        return False
    if not tokens:
        return False

    command_name = Path(tokens[0]).name
    if command_name in {"sed", "gsed"}:
        return any(token == "-i" or token.startswith("-i") for token in tokens[1:])
    if command_name == "perl":
        return any(token.startswith("-") and "i" in token for token in tokens[1:])
    if command_name in {"tee", "cp", "mv", "install"}:
        return True
    if ">" in command or ">>" in command:
        return True
    if is_python_executable(tokens[0]) and any(
        marker in raw for marker in ("write_text", "open(", "configparser", "include-system-site-packages")
    ):
        return True
    return False


def pyperformance_env_contract_hint(reason: str) -> str:
    markers = ["pyperformance 性能测试", "pyperformance worker", "pyperformance helper", "pyvenv.cfg"]
    if not any(marker in reason for marker in markers):
        return ""
    return (
        "worker 环境证据见 "
        "skills/using-cpython-optimize/references/pyperformance-env-contract.md；"
        "核对 worker venv 的 pyvenv.cfg、"
        "include-system-site-packages 或等价 PYTHONPATH、CinderX .pth、"
        "--inherit-environ、worker 内 cinderx.is_initialized() / "
        "cinderx.get_import_error() 均符合目标口径；已有匹配证据可复用。"
    )


def classify_chunk(chunk: list[str], command: str) -> tuple[str, str]:
    if is_pyvenv_cfg_mutation(chunk, command):
        return "deny", "pyvenv.cfg 环境改写; skills: cinderx-env-validate / pyperformance-worker-run / pyperformance-suite-run"

    if is_pip_install_local_project(chunk):
        return "deny", "pip install local project; skills: cinderx-env-validate / cinderx-env-bootstrap"

    is_perf, perf_module, arg_start = starts_perf_cli(chunk)
    if is_perf:
        args = chunk[arg_start:]
        subcommand = args[0] if args else ""
        if perf_module == "pyperformance" and subcommand == "run":
            if has_benchmark_subset(args[1:]):
                return "context", "targeted pyperformance 性能测试; skills: pyperformance-suite-run"
            return "deny", "full pyperformance 性能测试; skills: pyperformance-suite-run"
        if perf_module == "pyperf":
            if subcommand == "compare_to":
                return "context", "pyperf 结果命令; skills: pyperformance-result-compare"
            return "context", "pyperf 结果/性能命令; skills: pyperformance-result-compare / pyperformance-suite-run"
        return "context", "pyperformance CLI; skills: pyperformance-suite-run / pyperformance-worker-run / pyperformance-result-compare"

    run_gate, run_gate_reason, run_gate_full = is_cinderx_run_gate(chunk)
    if run_gate:
        return ("deny", run_gate_reason) if run_gate_full else ("context", run_gate_reason)

    if is_pyperformance_worker_command(chunk):
        return "context", "pyperformance worker 性能测试; skills: pyperformance-worker-run"

    if is_cinderx_benchmark_helper(chunk):
        return "deny", "CinderX pyperformance helper 性能测试; skills: pyperformance-worker-run / pyperformance-suite-run"

    runtime, full_suite = is_runtime_test(chunk)
    if runtime:
        if full_suite:
            return "deny", "full RuntimeTests 功能测试; skills: cpython-runtime-test-run"
        return "context", "targeted RuntimeTests 功能测试 / test_cinderx/lib test 集成测试; skills: cpython-runtime-test-run"

    if is_build_or_test(chunk):
        return "context", "build/test command; skills: cpython-runtime-test-run"

    return "ignore", ""


def classify_command(command: str) -> tuple[str, str]:
    tokens = shell_tokens(command)
    if not tokens or has_ack(tokens):
        return "ignore", ""

    context = ("ignore", "")
    for chunk in command_chunks(tokens):
        action, reason = classify_chunk(chunk, command)
        if action == "deny":
            return action, reason
        if action == "context" and context[0] == "ignore":
            context = action, reason
    return context


def git_root(cwd: Path) -> Path | None:
    try:
        result = subprocess.run(
            ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
            text=True,
            capture_output=True,
            check=True,
            timeout=2,
        )
    except Exception:
        return None
    root = result.stdout.strip()
    return Path(root) if root else None


def marker_root(cwd: Path) -> Path | None:
    current = cwd if cwd.is_dir() else cwd.parent
    for parent in [current, *current.parents]:
        if is_cpython_cinderx_root(parent):
            return parent
    return None


def is_cpython_cinderx_root(path: Path) -> bool:
    return (
        (path / "Include" / "patchlevel.h").is_file()
        and (path / "Python").is_dir()
        and (path / "Objects").is_dir()
        and (path / "Lib").is_dir()
    )


def in_cpython_cinderx_repo(cwd: Path) -> bool:
    root = git_root(cwd) or marker_root(cwd)
    return bool(root and is_cpython_cinderx_root(root))


def main() -> int:
    payload = load_payload()
    command = extract_command(payload)
    if not command:
        return 0

    action, reason = classify_command(command)
    if action == "ignore":
        return 0

    if not in_cpython_cinderx_repo(extract_cwd(payload)):
        return 0

    if action == "deny":
        emit_deny(
            f"CPython/CinderX 验证前置检查（{reason}）。"
            "全量或范围不明的运行按 validation-strategy 核对范围和预算；"
            "环境改写核对目标与隔离，保留已有产物。"
            f"{pyperformance_env_contract_hint(reason)}"
            "只读取当前动作需要的技能；已有授权和匹配证据可复用，不重复询问。"
            f"完成适用检查后以 {ACK_ENV}=1 前缀重试原命令；"
            "ACK 不替代用户授权或环境证据，不应全局设置。"
        )
        return 0

    emit_context(
        f"CPython/CinderX 验证提示（{reason}）。"
        f"{pyperformance_env_contract_hint(reason)}"
        "按需读取对应技能；在已授权范围内继续，记录命令、stdout/stderr、"
        "exit status 和产物路径。"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
