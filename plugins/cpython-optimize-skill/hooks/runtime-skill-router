#!/usr/bin/env bash
# Runtime signal hook for CPython/CinderX optimization workflows.

set -euo pipefail

payload="$(cat || true)"

extract_command() {
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$payload" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

tool_input = data.get("tool_input") if isinstance(data, dict) else None
if isinstance(tool_input, dict):
    command = tool_input.get("command") or tool_input.get("cmd")
else:
    command = None

if not command and isinstance(data, dict):
    command = data.get("command") or data.get("cmd")

if isinstance(command, str):
    sys.stdout.write(command)
'
    else
        printf '%s' "$payload" | sed -nE 's/.*"(command|cmd)"[[:space:]]*:[[:space:]]*"([^"]*)".*/\2/p' | head -n 1
    fi
}

extract_signal_text() {
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$payload" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

parts = []

def collect_response(obj):
    if not isinstance(obj, dict):
        return
    for key in ("stdout", "stderr", "output", "error", "message"):
        value = obj.get(key)
        if isinstance(value, str):
            parts.append(value)
    for key in ("tool_response", "tool_output", "response", "result"):
        collect_response(obj.get(key))

collect_response(data)
sys.stdout.write("\n".join(parts))
'
    else
        printf '%s' "$payload" | sed -nE 's/.*"(stdout|stderr|output|error|message)"[[:space:]]*:[[:space:]]*"([^"]*)".*/\2/p'
    fi
}

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

emit_context() {
    local message="$1"
    local escaped
    escaped="$(escape_for_json "$message")"
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
}

has_signal() {
    local pattern
    for pattern in "$@"; do
        if printf '%s' "$signal_text" | grep -Eiq -- "$pattern"; then
            return 0
        fi
    done
    return 1
}

is_observation_command() {
    local command_text="$1"
    local normalized
    normalized="$(printf '%s' "$command_text" | tr '\n' ' ' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+/ /g')"

    if command -v python3 >/dev/null 2>&1; then
        if python3 - "$normalized" <<'PY'
import os
import re
import shlex
import sys

READ_COMMANDS = {
    "rg",
    "grep",
    "sed",
    "cat",
    "less",
    "more",
    "head",
    "tail",
    "nl",
    "wc",
    "ls",
    "find",
}
GIT_READ_SUBCOMMANDS = {
    "show",
    "log",
    "diff",
    "grep",
    "blame",
    "status",
    "rev-parse",
    "ls-files",
    "reflog",
    "branch",
}
SHELLS = {"bash", "sh", "zsh"}
ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=.*")


def split(command):
    try:
        return shlex.split(command)
    except ValueError:
        return command.split()


def base_name(token):
    return os.path.basename(token)


def strip_leading_environment(tokens):
    if tokens and tokens[0] == "env":
        tokens = tokens[1:]
        while tokens and (tokens[0].startswith("-") or ASSIGNMENT_RE.match(tokens[0])):
            tokens = tokens[1:]
    while tokens and ASSIGNMENT_RE.match(tokens[0]):
        tokens = tokens[1:]
    return tokens


def command_after_timeout(tokens):
    if not tokens or base_name(tokens[0]) != "timeout":
        return None
    i = 1
    while i < len(tokens) and tokens[i].startswith("-"):
        i += 1
    if i < len(tokens):
        i += 1
    return " ".join(tokens[i:]) if i < len(tokens) else ""


def command_after_shell_c(tokens):
    if not tokens or base_name(tokens[0]) not in SHELLS:
        return None
    for i, token in enumerate(tokens[1:], start=1):
        if token in ("-c", "-lc") or (token.endswith("c") and token.startswith("-")):
            if i + 1 < len(tokens):
                return tokens[i + 1]
    return None


def command_after_ssh(tokens):
    if not tokens or base_name(tokens[0]) != "ssh":
        return None
    i = 1
    options_with_value = {"-b", "-c", "-D", "-E", "-F", "-i", "-J", "-L", "-l", "-m", "-O", "-o", "-p", "-Q", "-R", "-S", "-W", "-w"}
    while i < len(tokens):
        token = tokens[i]
        if token == "--":
            i += 1
            break
        if token.startswith("-"):
            if token in options_with_value and i + 1 < len(tokens):
                i += 2
            else:
                i += 1
            continue
        i += 1
        return " ".join(tokens[i:]) if i < len(tokens) else ""
    return None


def command_after_leading_cd(tokens):
    if tokens and tokens[0] == "cd" and "&&" in tokens:
        index = tokens.index("&&")
        return " ".join(tokens[index + 1 :])
    return None


def is_git_read(tokens):
    if not tokens or base_name(tokens[0]) != "git":
        return False
    i = 1
    while i < len(tokens):
        token = tokens[i]
        if token == "--no-pager":
            i += 1
            continue
        if token == "-C" and i + 1 < len(tokens):
            i += 2
            continue
        if token.startswith("-"):
            i += 1
            continue
        return token in GIT_READ_SUBCOMMANDS or (token == "stash" and i + 1 < len(tokens) and tokens[i + 1] == "show")
    return False


def is_observation(command, depth=0):
    if not command or depth > 4:
        return False

    tokens = strip_leading_environment(split(command))
    if not tokens:
        return False

    for unwrap in (command_after_shell_c, command_after_ssh, command_after_timeout, command_after_leading_cd):
        inner = unwrap(tokens)
        if inner:
            return is_observation(inner, depth + 1)

    if is_git_read(tokens):
        return True

    return base_name(tokens[0]) in READ_COMMANDS


sys.exit(0 if is_observation(sys.argv[1]) else 1)
PY
        then
            return 0
        fi
    fi

    case "$normalized" in
        git\ show*|git\ log*|git\ diff*|git\ grep*|git\ blame*|git\ status*|git\ rev-parse*|git\ ls-files*|git\ reflog*|git\ branch*|git\ stash\ show*)
            return 0
            ;;
        git\ --no-pager\ show*|git\ --no-pager\ log*|git\ --no-pager\ diff*|git\ --no-pager\ blame*)
            return 0
            ;;
        git\ -C\ *\ show*|git\ -C\ *\ log*|git\ -C\ *\ diff*|git\ -C\ *\ blame*)
            return 0
            ;;
        rg*|grep*|sed*|cat*|less*|more*|head*|nl*|wc*|ls*|find*)
            return 0
            ;;
    esac

    return 1
}

is_observation_output() {
    if command -v python3 >/dev/null 2>&1; then
        if printf '%s' "$signal_text" | python3 -c '
import re
import sys

text = sys.stdin.read()
signal_re = re.compile(
    r"(SIGSEGV|Segmentation fault|signal\s+11|exit[\s_-]*(?:status|code)?\s*[:=]?\s*139|core dump|core dumped|SIGABRT|Aborted\s*\(core dumped\)|gdb\s+bt\s+full)",
    re.IGNORECASE,
)
grep_hit_re = re.compile(
    r"^[^:\n]+(?:\.(?:md|rst|txt|py|c|cc|cpp|cxx|h|hpp|hh|json|ya?ml|toml|sh|bash|zsh|log)|/[^:\n]*):\d+:",
    re.IGNORECASE,
)

signal_lines = [line.strip() for line in text.splitlines() if signal_re.search(line)]
if signal_lines and all(grep_hit_re.match(line) for line in signal_lines):
    sys.exit(0)
sys.exit(1)
'
        then
            return 0
        fi
    fi

    return 1
}

command_text="$(extract_command || true)"
signal_text="$(extract_signal_text || true)"
duration_ms="$(printf '%s' "$payload" | sed -nE 's/.*"duration_ms"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -n 1)"

if [ -n "$command_text" ] && is_observation_command "$command_text"; then
    exit 0
fi

if [ -n "$signal_text" ] && is_observation_output; then
    exit 0
fi

# Remote smoke scripts often print EXIT_STATUS=139 or EXIT_CODE=139.
if has_signal \
    'SIGSEGV' \
    'Segmentation fault' \
    'signal[[:space:]]+11' \
    'exit[[:space:]_-]*(status|code)?[[:space:]]*[:=]?[" ]*139([^0-9]|$)' \
    '(exit|return)[_-]?(status|code)[[:space:]]*[:=][[:space:]"]*139([^0-9]|$)' \
    'exit 139' \
    'core dump' \
    'core dumped' \
    'SIGABRT' \
    'Aborted[[:space:]]*\(core dumped\)'
then
    emit_context "检测到 native crash（SIGSEGV / exit 139 / core dump）。使用 cinderx-gdb-core-triage：保留真实命令、stdout/stderr、exit status 和 core，采集 gdb bt full；JIT 相关再补 HIR/jit.log。需端到端复现时再用 workflow-cinderx-crash-triage，按 validation-strategy 控制补测范围。"
    exit 0
fi

if has_signal \
    'Command timed out' \
    'timeout' \
    'timed out' \
    'Connection timed out' \
    'Read timed out' \
    'Operation timed out' \
    'Temporary failure in name resolution' \
    'Could not resolve host' \
    'Network is unreachable' \
    'No route to host' \
    'TLS handshake timeout' \
    'pip.*Retrying'
then
    emit_context "检测到远端 lab 网络/下载异常或 timeout。按需用 cinderx-remote-lab-ops，先查进程、日志、exit status、DNS/代理/镜像源/cache，在已有预算内诊断和恢复；需要新增权限、改变指定方案或超出预算时再询问。"
    exit 0
fi

if [ -n "$duration_ms" ] && [ "$duration_ms" -ge 120000 ]; then
    if printf '%s' "$payload" | grep -Eq '"stdout"[[:space:]]*:[[:space:]]*""' \
        && printf '%s' "$payload" | grep -Eq '"stderr"[[:space:]]*:[[:space:]]*""'
    then
        emit_context "检测到 lab 命令长时间运行后 stdout/stderr 仍为空。按 cinderx-remote-lab-ops 查进程、exit status、tmux pane 和日志；沿用进度与预算策略，不盲目重复命令，只有恢复需超出已有授权或预算时才询问。"
        exit 0
    fi
fi

exit 0
